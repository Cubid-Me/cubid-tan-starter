# Browser-safe OIDC and hosted-flow config.
# These values are bundled into the browser because they use the VITE_ prefix.
VITE_CUBID_ISSUER_URL=https://id.cubid.me
VITE_CUBID_OIDC_CLIENT_ID=
VITE_CUBID_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_CUBID_PASSPORT_BASE_URL=https://passport.cubid.me
VITE_CUBID_CLEARPASS_PAGE_ID=

# Server-mediated SIWC/OIDC config.
# These keep the authorization callback and session handling on server routes.
CUBID_SIWC_ISSUER_URL=https://id.cubid.me
CUBID_SIWC_CLIENT_ID=
CUBID_SIWC_REDIRECT_URI=http://localhost:3000/api/cubid/siwc/callback
CUBID_SIWC_SCOPE="openid profile email"
# Required in production. Generate with: openssl rand -hex 32
# Server-only encryption key for SIWC session, transaction and trace cookies.
CUBID_SIWC_COOKIE_SECRET=
# Optional diagnostic target; OIDC discovery still controls authorization.
CUBID_SIWC_LOGIN_BASE_URL=https://login.cubid.me

# Server-only Cubid dapp API config.
# Never prefix these with VITE_.
# Get the dapp API key from https://admin.cubid.me/.
CUBID_API_BASE_URL=https://passport.cubid.me
CUBID_API_KEY=
CUBID_DAPP_ID=
